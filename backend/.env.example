# ==============================================================================
# Backend Environment Configuration Template (Render / Production)
# ==============================================================================

# Server Network & CORS
PORT=8000
ALLOWED_ORIGINS=*

# Storage Retention & Cleanup Limits
STORAGE_RETENTION_DAYS=30
MAX_STORAGE_MB=5000
CLEANUP_FAILED_JOBS_HOURS=24

# WhatsApp Notification Integration (pywhatkit & URL triggers)
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_NUMBER=+916360553165
WHATSAPP_COOLDOWN_MINUTES=60
WHATSAPP_CONFIDENCE_THRESHOLD=0.40
WHATSAPP_EMERGENCY_SERVICES_NUMBER=+91112

# Optional Twilio Voice & SMS Emergency Integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFIED_RECIPIENT_NUMBER=

# Database Location (Defaults to backend/av_scene_data.db)
DATABASE_PATH=
